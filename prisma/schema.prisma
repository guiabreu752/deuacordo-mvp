datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  ADMIN
  BUYER
  SUPPLIER
  CONSULTANT
}

enum DealStatus {
  DRAFT
  IN_NEGOTIATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

// --------------------------------------
// MODELS CORE & MODULARIDADE
// --------------------------------------

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  cnpj           String?  @unique
  enabledModules String[] @default(["deal-desk"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          UsersOnOrganizations[]
  deals          Deal[]
  costBreakdowns CostBreakdown[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations UsersOnOrganizations[]
  createdDeals  Deal[]                 @relation("CreatedDeals")

  @@map("users")
}

model UsersOnOrganizations {
  userId         String
  organizationId String
  role           Role         @default(BUYER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("users_on_organizations")
}

// --------------------------------------
// MÓDULO 1: DEAL DESK (CORE)
// --------------------------------------

model Deal {
  id           String     @id @default(cuid())
  title        String
  description  String?
  quantity     Int        @default(1)
  targetValue  Float?
  currentValue Float?
  savingValue  Float?
  status       DealStatus @default(DRAFT)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedDeals", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deals")
}

// --------------------------------------
// MÓDULO 2: AI BREAKDOWN / DEUACORDO BREAKDOWN (MVP)
// --------------------------------------

model CostBreakdown {
  id           String @id @default(cuid())
  productName  String // Nome do produto/serviço analisado
  sellingPrice Float  // Preço de venda praticado no mercado

  // ---- CENÁRIO ATUAL (CUSTOS MANUAIS) ----
  rawMaterialCost Float  @default(0) // Insumos / Matéria-Prima
  laborCost       Float  @default(0) // Mão de obra
  energyCost      Float  @default(0) // Energia / Utilidades
  logisticsCost   Float  @default(0) // Frete / Impostos / Outros
  currentMarkup   Float? // Markup calculado ((Preço - CustoTotal) / CustoTotal)
  currentProfit   Float? // Lucro líquido/bruto em R$

  // ---- CENÁRIO TARGET (DESEJADO / ESPELHADO) ----
  targetRawMaterialCost Float  @default(0)
  targetLaborCost       Float  @default(0)
  targetEnergyCost      Float  @default(0)
  targetLogisticsCost   Float  @default(0)
  targetSellingPrice    Float?
  targetMarkup          Float?
  targetProfit          Float?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cost_breakdowns")
}

// --------------------------------------
// MÓDULO 11: DEUACORDO ACADEMY (AFILIADOS)
// --------------------------------------

model AffiliateProduct {
  id            String   @id @default(cuid())
  title         String
  category      String   // 'livros' | 'cursos' | 'escritorio' | 'software'
  categoryLabel String
  description   String
  priceEstimate String
  rating        String   @default("5.0 ★")
  imageUrl      String
  affiliateUrl  String   // Link com o ID de comissão (Amazon, Hotmart, etc.)
  badge         String?  // Ex: "Mais Vendido", "Recomendado"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("affiliate_products")
}

// --------------------------------------
// MÓDULO 8: DEUACORDO PULSE (NOTÍCIAS & INTELIGÊNCIA B2B)
// --------------------------------------

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique // ex: "Aço & Metais", "Logística Global", "Energia", "Agronegócio"
  slug      String   @unique
  createdAt DateTime @default(now())

  articles NewsArticleOnCategories[]

  @@map("news_categories")
}

model NewsArticle {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  summary        String   @db.Text
  impactAnalysis String?  @db.Text // Análise visual/exclusiva para versão PAGA
  sourceName     String   // ex: "Reuters", "Valor Econômico", "Google News"
  sourceUrl      String   // URL da notícia original
  imageUrl       String?
  isFeatured     Boolean  @default(false)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  categories NewsArticleOnCategories[]

  @@map("news_articles")
}

model NewsArticleOnCategories {
  articleId  String
  categoryId String
  article    NewsArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@map("news_article_categories")
}