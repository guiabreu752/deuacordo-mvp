datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  ADMIN
  BUYER
  SUPPLIER
  CONSULTANT
}

enum DealStatus {
  DRAFT
  IN_NEGOTIATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

// --------------------------------------
// MODELS CORE & MODULARIDADE
// --------------------------------------

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  cnpj           String?  @unique
  enabledModules String[] @default(["deal-desk"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users UsersOnOrganizations[]
  deals Deal[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations UsersOnOrganizations[]
  createdDeals  Deal[]                 @relation("CreatedDeals")

  @@map("users")
}

model UsersOnOrganizations {
  userId         String
  organizationId String
  role           Role         @default(BUYER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("users_on_organizations")
}

// --------------------------------------
// MÓDULO 1: DEAL DESK (CORE)
// --------------------------------------

model Deal {
  id             String     @id @default(cuid())
  title          String
  description    String?
  targetValue    Float?
  currentValue   Float?
  savingValue    Float?
  status         DealStatus @default(DRAFT)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById    String
  createdBy      User         @relation("CreatedDeals", fields: [createdById], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("deals")
}